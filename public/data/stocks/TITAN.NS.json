ged its name to Titan Company Limited in August 2013. Titan Company Limited was incorporated in 1984 and is based in Bengaluru, India."},"intraday":[{"t":1790135100000,"o":4936.5,"h":4950.0,"l":4929.5,"c":4943.5,"v":13769},{"t":1790135400000,"o":4943.5,"h":4947.5,"l":4933.0,"c":4944.0,"v":18571},{"t":1790135700000,"o":4944.0,"h":4944.5,"l":4920.0,"c":4927.0,"v":13744},{"t":1790136000000,"o":4928.5,"h":4934.5,"l":4925.0,"c":4933.0,"v":4440},{"t":1790136300000,"o":4932.0,"h":4934.5,"l":4930.5,"c":4933.0,"v":2376},{"t":1790136600000,"o":4933.0,"h":4935.0,"l":4927.0,"c":4927.0,"v":3296},{"t":1790136900000,"o":4927.5,"h":4927.5,"l":4906.5,"c":4910.0,"v":7469},{"t":1790137200000,"o":4909.0,"h":4915.5,"l":4908.5,"c":4910.0,"v":5037},{"t":1790137500000,"o":4913.0,"h":4913.5,"l":4907.5,"c":4909.0,"v":3803},{"t":1790137800000,"o":4909.0,"h":4913.5,"l":4909.0,"c":4910.0,"v":4582},{"t":1790138100000,"o":4912.5,"h":4913.0,"l":4905.0,"c":4906.5,"v":4935},{"t":1790138400000,"o":4906.5,"h":4912.5,"l":4895.0,"c":4896.0,"v":8455},{"t":1790138700000,"o":4896.0,"h":4911.0,"l":4895.0,"c":4910.0,"v":12174},{"t":1790139000000,"o":4910.0,"h":4918.5,"l":4909.5,"c":4917.0,"v":8207},{"t":1790139300000,"o":4917.0,"h":4917.0,"l":4911.5,"c":4915.5,"v":4096},{"t":1790139600000,"o":4917.0,"h":4923.0,"l":4916.5,"c":4916.5,"v":4884},{"t":1790139900000,"o":4917.0,"h":4917.0,"l":4908.5,"c":4908.5,"v":5434},{"t":1790140200000,"o":4909.5,"h":4912.5,"l":4908.0,"c":4912.5,"v":3295},{"t":1790140500000,"o":4912.5,"h":4917.0,"l":4912.0,"c":4913.0,"v":4865},{"t":1790140800000,"o":4913.0,"h":4916.0,"l":4910.5,"c":4913.0,"v":3509},{"t":1790141100000,"o":4913.0,"h":4916.5,"l":4912.0,"c":4916.0,"v":3686},{"t":1790141400000,"o":4914.5,"h":4918.0,"l":4911.5,"c":4911.5,"v":3846},{"t":1790141700000,"o":4912.0,"h":4916.0,"l":4908.5,"c":4913.5,"v":17737},{"t":1790142000000,"o":4913.0,"h":4914.0,"l":4910.0,"c":4911.0,"v":4288},{"t":1790142300000,"o":4911.5,"h":4912.5,"l":4895.0,"c":4896.0,"v":28052},{"t":1790142600000,"